# Copy this file to server/.env and fill in the values.
# server/.env is git-ignored. Never commit real keys.
#
# For local development, run `npx supabase start` from the repo root and copy
# the "API URL" and the anon (or "Publishable") key it prints.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
